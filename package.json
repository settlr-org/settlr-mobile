{
  "name": "settlr-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"{app,src}/**/*.{ts,tsx}\" \"*.json\"",
    "format:check": "prettier --check \"{app,src}/**/*.{ts,tsx}\" \"*.json\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "export:web": "expo export --platform web",
    "emulator": "./scripts/emulator.sh",
    "e2e": "./scripts/e2e.sh",
    "maestro": "maestro test maestro/flows"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "latest",
    "expo-router": "latest",
    "expo-secure-store": "~57.0.2",
    "expo-status-bar": "latest",
    "expo-updates": "~57.0.18",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "latest",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "vitest": "latest"
  }
}
