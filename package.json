{
  "name": "settlr-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"{app,src}/**/*.{ts,tsx}\" \"*.json\"",
    "format:check": "prettier --check \"{app,src}/**/*.{ts,tsx}\" \"*.json\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "export:web": "expo export --platform web",
    "emulator": "./scripts/emulator.sh",
    "e2e": "./scripts/e2e.sh",
    "test:platform": "./scripts/test-platform.sh",
    "maestro": "maestro test maestro/flows"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.18",
    "expo-auth-session": "~57.0.10",
    "expo-constants": "~57.0.16",
    "expo-font": "~57.0.2",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.5",
    "expo-image-picker": "~57.0.10",
    "expo-linking": "~57.0.8",
    "expo-router": "latest",
    "expo-secure-store": "~57.0.2",
    "expo-sharing": "~57.0.9",
    "expo-status-bar": "latest",
    "expo-updates": "~57.0.19",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "latest",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "vitest": "latest"
  }
}
